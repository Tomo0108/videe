{
  "name": "videe",
  "version": "0.1.2",
  "private": true,
  "description": "Videe",
  "author": "Videe",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && node scripts/ensure-player-index.mjs && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "package:mac": "node scripts/check-platform.mjs darwin && npm run build && node scripts/ensure-player-index.mjs && electron-builder --mac --dir --publish never",
    "package:mac:dmg": "node scripts/check-platform.mjs darwin && npm run build && node scripts/ensure-player-index.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "package:win": "node scripts/check-platform.mjs win32 && npm run build && node scripts/ensure-player-index.mjs && electron-builder --win nsis --publish never",
    "package:ios": "node scripts/package-ios.mjs",
    "ios:sync": "npm run build && node scripts/ensure-player-index.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --test tests/*.test.mjs",
    "test:fixtures": "node scripts/create-fixtures.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug -derivedDataPath /tmp/videe-ios-build CODE_SIGNING_ALLOWED=NO build",
    "test:library": "node scripts/verify-library.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "test:playback": "node scripts/verify-playback.mjs",
    "test:ui": "node scripts/verify-tahoe.mjs",
    "test:tools": "node scripts/verify-tools.mjs",
    "test:storage": "node scripts/verify-storage.mjs",
    "test:organization": "node scripts/verify-organization.mjs",
    "test:collections": "node scripts/verify-collections.mjs",
    "test:folder": "node scripts/verify-folder.mjs"
  },
  "build": {
    "appId": "app.videe.player",
    "productName": "Videe",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/media.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "public/icons/Videe.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Videe-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "public/icons/Videe.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Videe-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Videe-${version}-win-setup.exe"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron": true,
    "ffmpeg-static": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
